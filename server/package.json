{
  "name": "aurelle-server",
  "version": "1.0.0",
  "private": true,
  "description": "Aurelle Backend API with Express, TypeScript, MongoDB Atlas, Socket.IO, and Argon2id session authentication",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "check:types": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "seed:staff": "tsx src/scripts/seed-staff.ts",
    "seed:menu": "tsx src/scripts/seed-menu.ts",
    "seed:vip": "tsx src/scripts/seed-vip.ts",
    "test": "tsx src/tests/staff-auth.test.ts",
    "test:menu": "tsx src/tests/menu-management.test.ts",
    "test:orders": "tsx src/tests/order-management.test.ts",
    "test:kitchen": "tsx src/tests/kitchen-management.test.ts",
    "test:sync": "tsx src/tests/realtime-order-sync.test.ts",
    "test:kds-lifecycle": "tsx src/tests/kds-order-lifecycle-e2e.test.ts",
    "test:reservations": "tsx src/tests/reservation-management.test.ts",
    "test:reception": "tsx src/tests/reception-management.test.ts",
    "test:floor": "tsx src/tests/floor-management.test.ts",
    "test:vip": "tsx src/tests/vip-events.test.ts",
    "test:manager": "tsx src/tests/manager.test.ts",
    "test:notifications": "tsx src/tests/notifications.test.ts",
    "test:stage15": "tsx src/tests/stage15-analytics-settings.test.ts",
    "test:stage16": "tsx src/tests/stage16-system-integration.test.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.7",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
