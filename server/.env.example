# ==============================================================================
# Aurelle Platform - Backend Environment Configuration Example
#
# Duplicate this file to `.env` in the server directory and provide real values.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Application Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Backend HTTP Server Port
PORT=5000

# MongoDB Atlas or Local Connection String
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/aurelle?retryWrites=true&w=majority
# For Local MongoDB: mongodb://127.0.0.1:27017/aurelle
MONGODB_URI=mongodb://127.0.0.1:27017/aurelle

# Permitted Client Origin for CORS and Socket.IO
CLIENT_ORIGIN=http://localhost:3000

# Cryptographically Secure Session Secret (minimum 16 characters, 32+ recommended)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_secure_random_session_secret_change_me_in_production_32chars

# Session Cookie Identifier Name
SESSION_NAME=aurelle.sid

# Session Cookie Lifetime in Days
COOKIE_MAX_AGE_DAYS=7
